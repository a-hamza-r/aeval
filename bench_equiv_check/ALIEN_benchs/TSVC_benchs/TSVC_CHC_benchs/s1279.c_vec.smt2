(declare-rel loop ((Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) Int Int ))
(declare-rel exit ())
(declare-var mult Int )
(declare-var mult1 Int )
(declare-var mult2 Int )
(declare-var mult3 Int )
(declare-var mult4 Int )
(declare-var mult5 Int )
(declare-var mult6 Int )
(declare-var mult7 Int )
(declare-var i Int )
(declare-var index_limit Int )
(declare-var a_i Int )
(declare-var a_i1 Int )
(declare-var a_i2 Int )
(declare-var a_i3 Int )
(declare-var a_i4 Int )
(declare-var a_i5 Int )
(declare-var a_i6 Int )
(declare-var a_i7 Int )
(declare-var b_i Int )
(declare-var c_i Int )
(declare-var c_i1 Int )
(declare-var c_i2 Int )
(declare-var c_i3 Int )
(declare-var c_i4 Int )
(declare-var c_i5 Int )
(declare-var c_i6 Int )
(declare-var c_i7 Int )
(declare-var c_select Int )
(declare-var c_select1 Int )
(declare-var c_select2 Int )
(declare-var c_select3 Int )
(declare-var c_select4 Int )
(declare-var c_select5 Int )
(declare-var c_select6 Int )
(declare-var c_select7 Int )
(declare-var count Int )
(declare-var a_array (Array Int Int) )
(declare-var c_array1 (Array Int Int) )
(declare-var c_array2 (Array Int Int) )
(declare-var c_array3 (Array Int Int) )
(declare-var c_array4 (Array Int Int) )
(declare-var c_array5 (Array Int Int) )
(declare-var c_array6 (Array Int Int) )
(declare-var c_array7 (Array Int Int) )
(declare-var c_array8 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var c_array (Array Int Int) )
(declare-var d_array (Array Int Int) )
(declare-var e_array (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(> count 0)
	)
	(loop a_array b_array c_array d_array e_array i count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array e_array i count)

		(< i (* count 8))
		
		(= a_i (select a_array i))
		(= c_select (select c_array i))
		(= mult (select d_array i) (select e_array i))
		(= c_i (ite (and (< a_i 0) (> (select b_array i) a_i)) (+ c_select mult) c_select))
		(= c_array1 (store c_array i c_i))

		(= a_i1 (select a_array (+ i 1)))
		(= c_select1 (select c_array1 (+ i 1)))
		(= mult1 (select d_array (+ i 1)) (select e_array (+ i 1)))
		(= c_i1 (ite (and (< a_i1 0) (> (select b_array (+ i 1)) a_i1)) (+ c_select1 mult1) c_select1))
		(= c_array2 (store c_array1 (+ i 1) c_i1))

		(= a_i2 (select a_array (+ i 2)))
		(= c_select2 (select c_array2 (+ i 2)))
		(= mult2 (select d_array (+ i 1)) (select e_array (+ i 2)))
		(= c_i2 (ite (and (< a_i2 0) (> (select b_array (+ i 2)) a_i2)) (+ c_select2 mult2) c_select2))
		(= c_array3 (store c_array2 (+ i 2) c_i2))

		(= a_i3 (select a_array (+ i 3)))
		(= c_select3 (select c_array3 (+ i 3)))
		(= mult3 (select d_array (+ i 3)) (select e_array (+ i 3)))
		(= c_i3 (ite (and (< a_i3 0) (> (select b_array (+ i 3)) a_i3)) (+ c_select3 mult3) c_select3))
		(= c_array4 (store c_array3 (+ i 3) c_i3))

		(= a_i4 (select a_array (+ i 4)))
		(= c_select4 (select c_array4 (+ i 4)))
		(= mult4 (select d_array (+ i 4)) (select e_array (+ i 4)))
		(= c_i4 (ite (and (< a_i4 0) (> (select b_array (+ i 4)) a_i4)) (+ c_select4 mult4) c_select4))
		(= c_array5 (store c_array4 (+ i 4) c_i4))

		(= a_i5 (select a_array (+ i 5)))
		(= c_select5 (select c_array5 (+ i 5)))
		(= mult5 (select d_array (+ i 5)) (select e_array (+ i 5)))
		(= c_i5 (ite (and (< a_i5 0) (> (select b_array (+ i 5)) a_i5)) (+ c_select5 mult5) c_select5))
		(= c_array6 (store c_array5 (+ i 5) c_i5))

		(= a_i6 (select a_array (+ i 6)))
		(= c_select6 (select c_array6 (+ i 6)))
		(= mult6 (select d_array (+ i 6)) (select e_array (+ i 6)))
		(= c_i6 (ite (and (< a_i6 0) (> (select b_array (+ i 6)) a_i6)) (+ c_select6 mult6) c_select6))
		(= c_array7 (store c_array6 (+ i 6) c_i6))

		(= a_i7 (select a_array (+ i 7)))
		(= c_select7 (select c_array7 (+ i 7)))
		(= mult7 (select d_array (+ i 7)) (select e_array (+ i 7)))
		(= c_i7 (ite (and (< a_i7 0) (> (select b_array (+ i 7)) a_i7)) (+ c_select7 mult7) c_select7))
		(= c_array8 (store c_array7 (+ i 7) c_i7))
	)
	(loop a_array b_array c_array8 d_array e_array (+ i 8) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array e_array i count)
		(not (< i (* count 8)))
	)
	exit
))
(query exit)