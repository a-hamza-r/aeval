(declare-var c_i1 Int )
(declare-var c_i2 Int )
(declare-var c_i3 Int )
(declare-var c_i4 Int )
(declare-var c_i5 Int )
(declare-var c_i6 Int )
(declare-var c_i7 Int )
(declare-var e_i7 Int )
(declare-var count Int )
(declare-var a_array (Array Int Int) )
(declare-var a_array1 (Array Int Int) )
(declare-var a_array2 (Array Int Int) )
(declare-var a_array3 (Array Int Int) )
(declare-var a_array4 (Array Int Int) )
(declare-var a_array5 (Array Int Int) )
(declare-var a_array6 (Array Int Int) )
(declare-var a_array7 (Array Int Int) )
(declare-var a_array8 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var b_array1 (Array Int Int) )
(declare-var b_array2 (Array Int Int) )
(declare-var b_array3 (Array Int Int) )
(declare-var b_array4 (Array Int Int) )
(declare-var b_array5 (Array Int Int) )
(declare-var b_array6 (Array Int Int) )
(declare-var b_array7 (Array Int Int) )
(declare-var b_array8 (Array Int Int) )
(declare-var c_array (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(> count 0)
	)
	(loop a_array b_array c_array i count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array i count)

		(< i (* count 8))
		
		(= a_i (select a_array (- (* count 8) i 1)))
		(= b_i (select b_array i))
		(= c_i (select c_array i))
		(= x (+ (* b_i c_i) a_i))
		(= a_array1 (store a_array i (- x 1)))
		(= b_array1 (store b_array i x))

		(= a_i1 (select a_array1 (- (* count 8) (+ i 1) 1)))
		(= b_i1 (select b_array1 (+ i 1)))
		(= c_i1 (select c_array (+ i 1)))
		(= x1 (+ (* b_i1 c_i1) a_i1))
		(= a_array2 (store a_array1 (+ i 1) (- x1 1)))
		(= b_array2 (store b_array1 (+ i 1) x1))

		(= a_i2 (select a_array2 (- (* count 8) (+ i 2) 1)))
		(= b_i2 (select b_array2 (+ i 2)))
		(= c_i2 (select c_array (+ i 2)))
		(= x2 (+ (* b_i2 c_i2) a_i2))
		(= a_array3 (store a_array2 (+ i 2) (- x2 1)))
		(= b_array3 (store b_array2 (+ i 2) x2))

		(= a_i3 (select a_array3 (- (* count 8) (+ i 3) 1)))
		(= b_i3 (select b_array3 (+ i 3)))
		(= c_i3 (select c_array (+ i 3)))
		(= x3 (+ (* b_i3 c_i3) a_i3))
		(= a_array4 (store a_array3 (+ i 3) (- x3 1)))
		(= b_array4 (store b_array3 (+ i 3) x3))

		(= a_i4 (select a_array4 (- (* count 8) (+ i 4) 1)))
		(= b_i4 (select b_array4 (+ i 4)))
		(= c_i4 (select c_array (+ i 4)))
		(= x4 (+ (* b_i4 c_i4) a_i4))
		(= a_array5 (store a_array4 (+ i 4) (- x4 1)))
		(= b_array5 (store b_array4 (+ i 4) x4))

		(= a_i5 (select a_array5 (- (* count 8) (+ i 5) 1)))
		(= b_i5 (select b_array5 (+ i 5)))
		(= c_i5 (select c_array (+ i 5)))
		(= x5 (+ (* b_i5 c_i5) a_i5))
		(= a_array6 (store a_array5 (+ i 5) (- x5 1)))
		(= b_array6 (store b_array5 (+ i 5) x5))

		(= a_i6 (select a_array6 (- (* count 8) (+ i 6) 1)))
		(= b_i6 (select b_array6 (+ i 6)))
		(= c_i6 (select c_array (+ i 6)))
		(= x6 (+ (* b_i6 c_i6) a_i6))
		(= a_array7 (store a_array6 (+ i 6) (- x6 1)))
		(= b_array7 (store b_array6 (+ i 6) x6))

		(= a_i7 (select a_array7 (- (* count 8) (+ i 7) 1)))
		(= b_i7 (select b_array7 (+ i 7)))
		(= c_i7 (select c_array (+ i 7)))
		(= x7 (+ (* b_i7 c_i7) a_i7))
		(= a_array8 (store a_array7 (+ i 7) (- x7 1)))
		(= b_array8 (store b_array7 (+ i 7) x7))
	)
	(loop a_array8 b_array8 c_array (+ i 8) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array i count)
		(not (< i (* count 8)))
	)
	exit
))
(query exit)