(declare-rel loop ((Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) Int Int ))
(declare-rel preLoop ((Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) Int Int ))
(declare-rel exit ())
(declare-var i Int )
(declare-var t Int )
(declare-var t1 Int )
(declare-var t2 Int )
(declare-var t3 Int )
(declare-var t4 Int )
(declare-var t5 Int )
(declare-var t6 Int )
(declare-var t7 Int )
(declare-var a_i Int )
(declare-var a_i1 Int )
(declare-var a_i2 Int )
(declare-var a_i3 Int )
(declare-var a_i4 Int )
(declare-var a_i5 Int )
(declare-var a_i6 Int )
(declare-var a_i7 Int )
(declare-var b_i Int )
(declare-var b_i1 Int )
(declare-var b_i2 Int )
(declare-var b_i3 Int )
(declare-var b_i4 Int )
(declare-var b_i5 Int )
(declare-var b_i6 Int )
(declare-var b_i7 Int )
(declare-var c_i Int )
(declare-var c_i1 Int )
(declare-var c_i2 Int )
(declare-var c_i3 Int )
(declare-var c_i4 Int )
(declare-var c_i5 Int )
(declare-var c_i6 Int )
(declare-var c_i7 Int )
(declare-var d_i Int )
(declare-var d_i1 Int )
(declare-var d_i2 Int )
(declare-var d_i3 Int )
(declare-var d_i4 Int )
(declare-var d_i5 Int )
(declare-var d_i6 Int )
(declare-var d_i7 Int )
(declare-var count Int )
(declare-var a_array (Array Int Int) )
(declare-var a_array1 (Array Int Int) )
(declare-var a_array2 (Array Int Int) )
(declare-var a_array3 (Array Int Int) )
(declare-var a_array4 (Array Int Int) )
(declare-var a_array5 (Array Int Int) )
(declare-var a_array6 (Array Int Int) )
(declare-var a_array7 (Array Int Int) )
(declare-var a_array8 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var d_array (Array Int Int) )
(declare-var d_array1 (Array Int Int) )
(declare-var d_array2 (Array Int Int) )
(declare-var d_array3 (Array Int Int) )
(declare-var d_array4 (Array Int Int) )
(declare-var d_array5 (Array Int Int) )
(declare-var d_array6 (Array Int Int) )
(declare-var d_array7 (Array Int Int) )
(declare-var d_array8 (Array Int Int) )
(declare-var c_array (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(> count 0)
	)
	(preLoop a_array b_array c_array d_array i count)
))
(rule (=> 
	(and 
		(preLoop a_array b_array c_array d_array i count)
		
		(= t (select a_array (+ i 1)))
		(= b_i (select b_array i))
		(= c_i (select c_array i))
		(= a_i (+ (+ (+ b_i (* c_i c_i)) (* b_i b_i)) c_i))
		(= a_array1 (store a_array i a_i))
		(= d_i (+ (select a_array1 i) t))
		(= d_array1 (store d_array i d_i))

		(= t1 (select a_array1 (+ i 2)))
		(= b_i1 (select b_array (+ i 1)))
		(= c_i1 (select c_array (+ i 1)))
		(= a_i1 (+ (+ (+ b_i1 (* c_i1 c_i1)) (* b_i1 b_i1)) c_i1))
		(= a_array2 (store a_array1 (+ i 1) a_i1))
		(= d_i1 (+ (select a_array2 (+ i 1)) t1))
		(= d_array2 (store d_array1 (+ i 1) d_i1))

		(= t2 (select a_array2 (+ i 3)))
		(= b_i2 (select b_array (+ i 2)))
		(= c_i2 (select c_array (+ i 2)))
		(= a_i2 (+ (+ (+ b_i2 (* c_i2 c_i2)) (* b_i2 b_i2)) c_i2))
		(= a_array3 (store a_array2 (+ i 2) a_i2))
		(= d_i2 (+ (select a_array3 (+ i 2)) t2))
		(= d_array3 (store d_array2 (+ i 2) d_i2))

		(= t3 (select a_array3 (+ i 4)))
		(= b_i3 (select b_array (+ i 3)))
		(= c_i3 (select c_array (+ i 3)))
		(= a_i3 (+ (+ (+ b_i3 (* c_i3 c_i3)) (* b_i3 b_i3)) c_i3))
		(= a_array4 (store a_array3 (+ i 3) a_i3))
		(= d_i3 (+ (select a_array4 (+ i 3)) t3))
		(= d_array4 (store d_array3 (+ i 3) d_i3))

		(= t4 (select a_array4 (+ i 5)))
		(= b_i4 (select b_array (+ i 4)))
		(= c_i4 (select c_array (+ i 4)))
		(= a_i4 (+ (+ (+ b_i4 (* c_i4 c_i4)) (* b_i4 b_i4)) c_i4))
		(= a_array5 (store a_array4 (+ i 4) a_i4))
		(= d_i4 (+ (select a_array5 (+ i 4)) t4))
		(= d_array5 (store d_array4 (+ i 4) d_i4))

		(= t5 (select a_array5 (+ i 6)))
		(= b_i5 (select b_array (+ i 5)))
		(= c_i5 (select c_array (+ i 5)))
		(= a_i5 (+ (+ (+ b_i5 (* c_i5 c_i5)) (* b_i5 b_i5)) c_i5))
		(= a_array6 (store a_array5 (+ i 5) a_i5))
		(= d_i5 (+ (select a_array6 (+ i 5)) t5))
		(= d_array6 (store d_array5 (+ i 5) d_i5))

		(= t6 (select a_array6 (+ i 7)))
		(= b_i6 (select b_array (+ i 6)))
		(= c_i6 (select c_array (+ i 6)))
		(= a_i6 (+ (+ (+ b_i6 (* c_i6 c_i6)) (* b_i6 b_i6)) c_i6))
		(= a_array7 (store a_array6 (+ i 6) a_i6))
		(= d_i6 (+ (select a_array7 (+ i 6)) t6))
		(= d_array7 (store d_array6 (+ i 6) d_i6))
	)
	(loop a_array7 b_array c_array d_array7 (+ i 7) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array i count)
		(< i (- (* count 8) 1))

		(= t (select a_array (+ i 1)))
		(= b_i (select b_array i))
		(= c_i (select c_array i))
		(= a_i (+ (+ (+ b_i (* c_i c_i)) (* b_i b_i)) c_i))
		(= a_array1 (store a_array i a_i))
		(= d_i (+ (select a_array1 i) t))
		(= d_array1 (store d_array i d_i))

		(= t1 (select a_array1 (+ i 2)))
		(= b_i1 (select b_array (+ i 1)))
		(= c_i1 (select c_array (+ i 1)))
		(= a_i1 (+ (+ (+ b_i1 (* c_i1 c_i1)) (* b_i1 b_i1)) c_i1))
		(= a_array2 (store a_array1 (+ i 1) a_i1))
		(= d_i1 (+ (select a_array2 (+ i 1)) t1))
		(= d_array2 (store d_array1 (+ i 1) d_i1))

		(= t2 (select a_array2 (+ i 3)))
		(= b_i2 (select b_array (+ i 2)))
		(= c_i2 (select c_array (+ i 2)))
		(= a_i2 (+ (+ (+ b_i2 (* c_i2 c_i2)) (* b_i2 b_i2)) c_i2))
		(= a_array3 (store a_array2 (+ i 2) a_i2))
		(= d_i2 (+ (select a_array3 (+ i 2)) t2))
		(= d_array3 (store d_array2 (+ i 2) d_i2))

		(= t3 (select a_array3 (+ i 4)))
		(= b_i3 (select b_array (+ i 3)))
		(= c_i3 (select c_array (+ i 3)))
		(= a_i3 (+ (+ (+ b_i3 (* c_i3 c_i3)) (* b_i3 b_i3)) c_i3))
		(= a_array4 (store a_array3 (+ i 3) a_i3))
		(= d_i3 (+ (select a_array4 (+ i 3)) t3))
		(= d_array4 (store d_array3 (+ i 3) d_i3))

		(= t4 (select a_array4 (+ i 5)))
		(= b_i4 (select b_array (+ i 4)))
		(= c_i4 (select c_array (+ i 4)))
		(= a_i4 (+ (+ (+ b_i4 (* c_i4 c_i4)) (* b_i4 b_i4)) c_i4))
		(= a_array5 (store a_array4 (+ i 4) a_i4))
		(= d_i4 (+ (select a_array5 (+ i 4)) t4))
		(= d_array5 (store d_array4 (+ i 4) d_i4))

		(= t5 (select a_array5 (+ i 6)))
		(= b_i5 (select b_array (+ i 5)))
		(= c_i5 (select c_array (+ i 5)))
		(= a_i5 (+ (+ (+ b_i5 (* c_i5 c_i5)) (* b_i5 b_i5)) c_i5))
		(= a_array6 (store a_array5 (+ i 5) a_i5))
		(= d_i5 (+ (select a_array6 (+ i 5)) t5))
		(= d_array6 (store d_array5 (+ i 5) d_i5))

		(= t6 (select a_array6 (+ i 7)))
		(= b_i6 (select b_array (+ i 6)))
		(= c_i6 (select c_array (+ i 6)))
		(= a_i6 (+ (+ (+ b_i6 (* c_i6 c_i6)) (* b_i6 b_i6)) c_i6))
		(= a_array7 (store a_array6 (+ i 6) a_i6))
		(= d_i6 (+ (select a_array7 (+ i 6)) t6))
		(= d_array7 (store d_array6 (+ i 6) d_i6))

		(= t7 (select a_array7 (+ i 8)))
		(= b_i7 (select b_array (+ i 7)))
		(= c_i7 (select c_array (+ i 7)))
		(= a_i7 (+ (+ (+ b_i7 (* c_i7 c_i7)) (* b_i7 b_i7)) c_i7))
		(= a_array8 (store a_array7 (+ i 7) a_i7))
		(= d_i7 (+ (select a_array8 (+ i 7)) t7))
		(= d_array8 (store d_array7 (+ i 7) d_i7))
	)
	(loop a_array8 b_array c_array d_array8 (+ i 8) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array i count)
		(not (< i (- (* count 8) 1)))
	)
	exit
))
(query exit)
