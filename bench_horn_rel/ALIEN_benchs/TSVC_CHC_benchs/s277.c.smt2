(declare-rel loop ((Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) Int Int ))
(declare-rel exit ())
(declare-var i Int )
(declare-var a_i Int )
(declare-var b_i Int )
(declare-var c_i Int )
(declare-var a_i1 Int )
(declare-var a_i2 Int )
(declare-var b_i1 Int )
(declare-var c_i1 Int )
(declare-var d_i Int )
(declare-var e_i Int )
(declare-var count Int )
(declare-var a_array (Array Int Int) )
(declare-var a_array1 (Array Int Int) )
(declare-var a_array2 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var b_array1 (Array Int Int) )
(declare-var c_array (Array Int Int) )
(declare-var d_array (Array Int Int) )
(declare-var e_array (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(> count 0)
	)
	(loop b_array c_array d_array e_array i count)
))
(rule (=> 
	(and 
		(loop b_array c_array d_array e_array i count)
		(< i (- (* count 8) 1))
		(= c_i (select c_array i))
		(= d_i (select d_array i))
		(= e_i (select e_array i))
		(= b_i (ite (>= (select b_array i) 0) (+ c_i (* d_i e_i)) (select b_array (+ i 1))))
		(= b_array1 (store b_array (+ i 1) b_i))
	)
	(loop b_array1 c_array d_array e_array (+ i 1) count)
))
(rule (=> 
	(and 
		(loop b_array c_array d_array e_array i count)
		(not (< i (- (* count 8) 1)))
	)
	exit
))
(query exit)