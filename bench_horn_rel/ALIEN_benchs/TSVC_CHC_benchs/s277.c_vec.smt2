		(> count 0)
	)
	(preLoop b_array c_array d_array e_array i count)
))
(rule (=> 
	(and 
		(preLoop b_array c_array d_array e_array i count)

		(= c_i (select c_array i))
		(= d_i (select d_array i))
		(= e_i (select e_array i))
		(= b_i (ite (>= (select b_array i) 0) (+ c_i (* d_i e_i)) (select b_array (+ i 1))))
		(= b_array1 (store b_array (+ i 1) b_i))

