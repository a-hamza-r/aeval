(declare-var a (Array Int (Array Int Int)))
(declare-var a1 (Array Int (Array Int Int)))
(declare-var a2 (Array Int (Array Int Int)))
(declare-var a3 (Array Int (Array Int Int)))
(declare-var a4 (Array Int (Array Int Int)))
(declare-var a5 (Array Int (Array Int Int)))
(declare-var a6 (Array Int (Array Int Int)))
(declare-var a7 (Array Int (Array Int Int)))
(declare-var a8 (Array Int (Array Int Int)))
(declare-var b (Array Int (Array Int Int)))
(declare-var i Int)
(declare-var i1 Int)
(declare-var j Int)
(declare-var j1 Int)
(declare-var count Int)

(declare-rel inv1 ((Array Int (Array Int Int)) (Array Int (Array Int Int)) Int Int Int))
(declare-rel inv2 ((Array Int (Array Int Int)) (Array Int (Array Int Int)) Int Int Int))
(declare-rel fail ())

(rule (=> 
    (and 
        (> count 0)
    )
    (inv1 a b 1 j count)
))

(rule (=> (and 
  (inv1 a b i j count) 
  (< i count)
  (= a1 (store a i (store (select a i) 1 (+ (select (select a (- i 1)) (- 1 1)) (select (select b i) 1)))))
  (= a2 (store a1 i (store (select a1 i) (+ 1 1) (+ (select (select a1 (- i 1)) 1) (select (select b i) (+ 1 1))))))
  (= a3 (store a2 i (store (select a2 i) (+ 1 2) (+ (select (select a2 (- i 1)) (+ 1 1)) (select (select b i) (+ 1 2))))))
  (= a4 (store a3 i (store (select a3 i) (+ 1 3) (+ (select (select a3 (- i 1)) (+ 1 2)) (select (select b i) (+ 1 3))))))
  (= a5 (store a4 i (store (select a4 i) (+ 1 4) (+ (select (select a4 (- i 1)) (+ 1 3)) (select (select b i) (+ 1 4))))))
  (= a6 (store a5 i (store (select a5 i) (+ 1 5) (+ (select (select a5 (- i 1)) (+ 1 4)) (select (select b i) (+ 1 5))))))
  (= a7 (store a6 i (store (select a6 i) (+ 1 6) (+ (select (select a6 (- i 1)) (+ 1 5)) (select (select b i) (+ 1 6))))))
  (= j 8))
(inv2 a7 b i j count)))

(rule (=> (and (inv2 a b i j count)
  (< j (* count 8))
  (= a1 (store a i (store (select a i) j (+ (select (select a (- i 1)) (- j 1)) (select (select b i) j)))))
  (= a2 (store a1 i (store (select a1 i) (+ j 1) (+ (select (select a1 (- i 1)) j) (select (select b i) (+ j 1))))))
  (= a3 (store a2 i (store (select a2 i) (+ j 2) (+ (select (select a2 (- i 1)) (+ j 1)) (select (select b i) (+ j 2))))))
  (= a4 (store a3 i (store (select a3 i) (+ j 3) (+ (select (select a3 (- i 1)) (+ j 2)) (select (select b i) (+ j 3))))))
  (= a5 (store a4 i (store (select a4 i) (+ j 4) (+ (select (select a4 (- i 1)) (+ j 3)) (select (select b i) (+ j 4))))))
  (= a6 (store a5 i (store (select a5 i) (+ j 5) (+ (select (select a5 (- i 1)) (+ j 4)) (select (select b i) (+ j 5))))))
  (= a7 (store a6 i (store (select a6 i) (+ j 6) (+ (select (select a6 (- i 1)) (+ j 5)) (select (select b i) (+ j 6))))))
  (= a8 (store a7 i (store (select a7 i) (+ j 7) (+ (select (select a7 (- i 1)) (+ j 6)) (select (select b i) (+ j 7))))))
  (= j1 (+ j 8)))
    (inv2 a8 b i j1 count)))

(rule (=> (and (inv2 a b i j count)
  (not (< j (* count 8))) (= i1 (+ i 1))) (inv1 a b i1 j count)))

(rule (=> (and (inv1 a b i j count) (not (< i count))) fail))

(query fail)