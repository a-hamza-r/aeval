(declare-var a_array8 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var c_array (Array Int Int) )
(declare-var d_array (Array Int Int) )
(declare-var e_array (Array Int Int) )


(rule (=> 
	(and 
		(= i 0)
		(> count 0)
	)
	(preLoop a_array b_array c_array d_array e_array i count)
))
(rule (=> 
	(and 
		(preLoop a_array b_array c_array d_array e_array i count)
		
		(= b_i (select b_array i))
		(= c_i (select c_array i))
		(= d_i (select d_array i))
		(= e_i (select e_array i))
		(= a_j (+ b_i (* c_i d_i)))
		(= a_j1 (+ b_i (* d_i e_i)))
		(= a_array1 (store a_array (* 2 i) a_j))
		(= a_array2 (store a_array1 (+ (* 2 i) 1) a_j1))

		(= b_i1 (select b_array (+ i 1)))
		(= c_i1 (select c_array (+ i 1)))
		(= d_i1 (select d_array (+ i 1)))
		(= e_i1 (select e_array (+ i 1)))
		(= a_j2 (+ b_i1 (* c_i1 d_i1)))
		(= a_j3 (+ b_i1 (* d_i1 e_i1)))
		(= a_array3 (store a_array2 (* 2 (+ i 1)) a_j2))
		(= a_array4 (store a_array3 (+ (* 2 (+ i 1)) 1) a_j3))

		(= b_i2 (select b_array (+ i 2)))
		(= c_i2 (select c_array (+ i 2)))
		(= d_i2 (select d_array (+ i 2)))
		(= e_i2 (select e_array (+ i 2)))
		(= a_j4 (+ b_i2 (* c_i2 d_i2)))
		(= a_j5 (+ b_i2 (* d_i2 e_i2)))
		(= a_array5 (store a_array4 (* 2 (+ i 2)) a_j4))
		(= a_array6 (store a_array5 (+ (* 2 (+ i 2)) 1) a_j5))
	)
	(loop a_array6 b_array c_array d_array e_array (+ i 3) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array e_array i count)

		(< i (- (* count 4) 1))
		
		(= b_i (select b_array i))
		(= c_i (select c_array i))
		(= d_i (select d_array i))
		(= e_i (select e_array i))
		(= a_j (+ b_i (* c_i d_i)))
		(= a_j1 (+ b_i (* d_i e_i)))
		(= a_array1 (store a_array (* 2 i) a_j))
		(= a_array2 (store a_array1 (+ (* 2 i) 1) a_j1))

		(= b_i1 (select b_array (+ i 1)))
		(= c_i1 (select c_array (+ i 1)))
		(= d_i1 (select d_array (+ i 1)))
		(= e_i1 (select e_array (+ i 1)))
		(= a_j2 (+ b_i1 (* c_i1 d_i1)))
		(= a_j3 (+ b_i1 (* d_i1 e_i1)))
		(= a_array3 (store a_array2 (* 2 (+ i 1)) a_j2))
		(= a_array4 (store a_array3 (+ (* 2 (+ i 1)) 1) a_j3))

		(= b_i2 (select b_array (+ i 2)))
		(= c_i2 (select c_array (+ i 2)))
		(= d_i2 (select d_array (+ i 2)))
		(= e_i2 (select e_array (+ i 2)))
		(= a_j4 (+ b_i2 (* c_i2 d_i2)))
		(= a_j5 (+ b_i2 (* d_i2 e_i2)))
		(= a_array5 (store a_array4 (* 2 (+ i 2)) a_j4))
		(= a_array6 (store a_array5 (+ (* 2 (+ i 2)) 1) a_j5))

		(= b_i3 (select b_array (+ i 3)))
		(= c_i3 (select c_array (+ i 3)))
		(= d_i3 (select d_array (+ i 3)))
		(= e_i3 (select e_array (+ i 3)))
		(= a_j6 (+ b_i3 (* c_i3 d_i3)))
		(= a_j7 (+ b_i3 (* d_i3 e_i3)))
		(= a_array7 (store a_array6 (* 2 (+ i 3)) a_j6))
		(= a_array8 (store a_array7 (+ (* 2 (+ i 3)) 1) a_j7))
	)
	(loop a_array8 b_array c_array d_array e_array (+ i 4) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array e_array i count)
		(not (< i (- (* count 4) 1)))
	)
	exit
))
(query exit)