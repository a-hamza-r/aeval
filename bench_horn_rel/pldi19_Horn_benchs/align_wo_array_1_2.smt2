(declare-var b_array (Array Int Int) )

(rule (=> 
	(and 
		(= i (- (* count 8) 1))
		(> count 0)
	)
	(preLoop i count)
))
(rule (=> 
	(and 
		(preLoop i count)
		;(= a_array1 (store a_array i (+ (select a_array i) 1)))
	)
	(loop (- i 1) count))
)
(rule (=> 
	(and 
		(loop i count)
		(>= i 3)
		;(= a_array1 (store a_array i (+ (select a_array i) 1)))
		;(= a_array2 (store a_array1 (- i 1) (+ (select a_array1 (- i 1)) 1)))
	)
	(loop (- i 2) count)
))
(rule (=> 
	(and 
		(loop i count)
		(<= i 2)
		;(= a_array1 (store a_array i (+ (select a_array i) 1)))
	)
	(postLoop (- i 2) count)
))
(rule (=> 
	(and
		(postLoop i count)
		(not (>= i 1))
	)
	exit
))
(query exit)