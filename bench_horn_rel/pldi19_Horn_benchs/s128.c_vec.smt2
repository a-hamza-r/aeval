(declare-rel loop ((Array Int Int) (Array Int Int) (Array Int Int) (Array Int Int) Int Int Int ))
(declare-rel exit ())
(declare-var i Int )
(declare-var j Int )
(declare-var k Int )
(declare-var k1 Int )
(declare-var k2 Int )
(declare-var k3 Int )
(declare-var a_i Int )
(declare-var a_i1 Int )
(declare-var a_i2 Int )
(declare-var a_i3 Int )
(declare-var b_k Int )
(declare-var b_k1 Int )
(declare-var b_k2 Int )
(declare-var b_k3 Int )
(declare-var c_k Int )
(declare-var c_k1 Int )
(declare-var c_k2 Int )
(declare-var c_k3 Int )
(declare-var d_i Int )
(declare-var d_i1 Int )
(declare-var d_i2 Int )
(declare-var d_i3 Int )
(declare-var count Int )
(declare-var a_array (Array Int Int) )
(declare-var a_array1 (Array Int Int) )
(declare-var a_array2 (Array Int Int) )
(declare-var a_array3 (Array Int Int) )
(declare-var a_array4 (Array Int Int) )
(declare-var b_array (Array Int Int) )
(declare-var b_array1 (Array Int Int) )
(declare-var b_array2 (Array Int Int) )
(declare-var b_array3 (Array Int Int) )
(declare-var b_array4 (Array Int Int) )
(declare-var c_array (Array Int Int) )
(declare-var d_array (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(= j -1)
		(> count 0)
	)
	(loop a_array b_array c_array d_array i j count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array i j count)

		(< i (* count 4))
		
		(= k (+ j 1))
		(= b_k (select b_array k))
		(= c_k (select c_array k))
		(= d_i (select d_array i))
		(= a_i (- b_k d_i))
		(= a_array1 (store a_array i a_i))
		(= b_array1 (store b_array k (+ a_i c_k)))

		(= k1 (+ j 3))
		(= b_k1 (select b_array1 k1))
		(= c_k1 (select c_array k1))
		(= d_i1 (select d_array (+ i 1)))
		(= a_i1 (- b_k1 d_i1))
		(= a_array2 (store a_array1 (+ i 1) a_i1))
		(= b_array2 (store b_array1 k1 (+ a_i1 c_k1)))

		(= k2 (+ j 5))
		(= b_k2 (select b_array2 k2))
		(= c_k2 (select c_array k2))
		(= d_i2 (select d_array (+ i 2)))
		(= a_i2 (- b_k2 d_i2))
		(= a_array3 (store a_array2 (+ i 2) a_i2))
		(= b_array3 (store b_array2 k2 (+ a_i2 c_k2)))

		(= k3 (+ j 7))
		(= b_k3 (select b_array3 k3))
		(= c_k3 (select c_array k3))
		(= d_i3 (select d_array (+ i 3)))
		(= a_i3 (- b_k3 d_i3))
		(= a_array4 (store a_array3 (+ i 3) a_i3))
		(= b_array4 (store b_array3 k3 (+ a_i3 c_k3)))
	)
	(loop a_array4 b_array4 c_array d_array (+ i 4) (+ j 8) count)
))
(rule (=> 
	(and 
		(loop a_array b_array c_array d_array i j count)
		(not (< i (* count 4)))
	)
	exit
))
(query exit)