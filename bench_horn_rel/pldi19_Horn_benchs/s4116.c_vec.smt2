(declare-rel loop ((Array Int Int) (Array Int (Array Int Int)) (Array Int Int) Int Int Int Int Int ))
(declare-rel postLoop ((Array Int Int) (Array Int (Array Int Int)) (Array Int Int) Int Int Int Int Int ))
(declare-rel exit ())
(declare-var i Int )
(declare-var j Int )
(declare-var inc Int )
(declare-var sum Int )
(declare-var sum1 Int )
(declare-var sum2 Int )
(declare-var sum3 Int )
(declare-var sum4 Int )
(declare-var sum5 Int )
(declare-var sum6 Int )
(declare-var sum7 Int )
(declare-var sum8 Int )
(declare-var i1 Int )
(declare-var count Int )
(declare-var a (Array Int Int) )
(declare-var ip (Array Int Int) )
(declare-var aa (Array Int (Array Int Int)) )
(declare-var a1 (Array Int Int) )

(rule (=> 
	(and 
		(= i 0)
		(= sum 0)
		(> count 0)
	)
	(loop a aa ip i j inc sum count)
))
(rule (=> 
	(and 
		(loop a aa ip i j inc sum count)
		(< i (- (* count 8) 8))
		(= sum1 (+ sum (* (select a (+ inc i)) (select (select aa (- j 1)) (select ip i)))))
		(= sum2 (+ sum1 (* (select a (+ inc (+ i 1))) (select (select aa (- j 1)) (select ip (+ i 1))))))
		(= sum3 (+ sum2 (* (select a (+ inc (+ i 2))) (select (select aa (- j 1)) (select ip (+ i 2))))))
		(= sum4 (+ sum3 (* (select a (+ inc (+ i 3))) (select (select aa (- j 1)) (select ip (+ i 3))))))
		(= sum5 (+ sum4 (* (select a (+ inc (+ i 4))) (select (select aa (- j 1)) (select ip (+ i 4))))))
		(= sum6 (+ sum5 (* (select a (+ inc (+ i 5))) (select (select aa (- j 1)) (select ip (+ i 5))))))
		(= sum7 (+ sum6 (* (select a (+ inc (+ i 6))) (select (select aa (- j 1)) (select ip (+ i 6))))))
		(= sum8 (+ sum7 (* (select a (+ inc (+ i 7))) (select (select aa (- j 1)) (select ip (+ i 7))))))
		(= i1 (+ i 8))
	)
	(loop a aa ip i1 j inc sum8 count)
))
(rule (=> 
	(and 
		(loop a aa ip i j inc sum count)
		(= sum1 (+ sum (* (select a (+ inc i)) (select (select aa (- j 1)) (select ip i)))))
		(= sum2 (+ sum1 (* (select a (+ inc (+ i 1))) (select (select aa (- j 1)) (select ip (+ i 1))))))
		(= sum3 (+ sum2 (* (select a (+ inc (+ i 2))) (select (select aa (- j 1)) (select ip (+ i 2))))))
		(= sum4 (+ sum3 (* (select a (+ inc (+ i 3))) (select (select aa (- j 1)) (select ip (+ i 3))))))
		(= sum5 (+ sum4 (* (select a (+ inc (+ i 4))) (select (select aa (- j 1)) (select ip (+ i 4))))))
		(= sum6 (+ sum5 (* (select a (+ inc (+ i 5))) (select (select aa (- j 1)) (select ip (+ i 5))))))
		(= sum7 (+ sum6 (* (select a (+ inc (+ i 6))) (select (select aa (- j 1)) (select ip (+ i 6))))))
		(= i1 (+ i 7))) 
	(postLoop a aa ip i1 j inc sum7 count)))
(rule (=> 
	(and 
		(postLoop a aa ip i j inc sum count)
		(not (< i (- (* count 8) 1)))
	)
	exit
))
(query exit)